// branching.nano — demonstrates: nested if/else, boolean expressions,
// comparison operators, and logical &&/||.
//
// Expected output:
//   positive
//   negative
//   zero
//   in range

int sign(int x) {
    if (x > 0) {
        return 1;
    } else {
        if (x < 0) {
            return -1;
        } else {
            return 0;
        }
    }
}

int inRange(int x, int lo, int hi) {
    if (x >= lo && x <= hi) {
        return 1;
    }
    return 0;
}

int main() {
    int s = sign(5);
    if (s == 1)  { print "positive"; }
    if (s == -1) { print "negative"; }
    if (s == 0)  { print "zero"; }

    int s2 = sign(-3);
    if (s2 == 1)  { print "positive"; }
    if (s2 == -1) { print "negative"; }
    if (s2 == 0)  { print "zero"; }

    int s3 = sign(0);
    if (s3 == 1)  { print "positive"; }
    if (s3 == -1) { print "negative"; }
    if (s3 == 0)  { print "zero"; }

    if (inRange(7, 1, 10)) {
        print "in range";
    }

    return 0;
}
