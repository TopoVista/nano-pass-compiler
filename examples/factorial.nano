// factorial.nano — demonstrates: recursive functions, conditionals, and
// integer arithmetic.
//
// Expected output:
//   1
//   1
//   2
//   6
//   24
//   120

int fact(int n) {
    if (n <= 1) {
        return 1;
    }
    return n * fact(n - 1);
}

int main() {
    print fact(0);
    print fact(1);
    print fact(2);
    print fact(3);
    print fact(4);
    print fact(5);
    return 0;
}
