// functions.nano — demonstrates: multiple functions, forward calls,
// parameter passing, and return values of different types.
//
// Expected output:
//   15
//   3
//   1

int add(int a, int b) {
    return a + b;
}

int multiply(int a, int b) {
    return a * b;
}

// max uses a forward reference to min (both declared before main,
// which is sufficient for the predeclaration pass).
int min(int a, int b) {
    if (a < b) { return a; }
    return b;
}

int max(int a, int b) {
    if (a > b) { return a; }
    return b;
}

int clamp(int x, int lo, int hi) {
    return max(lo, min(x, hi));
}

int main() {
    // add(6, 9) == 15
    print add(6, 9);

    // max(3, 1) == 3
    print max(3, 1);

    // clamp(-5, 1, 10) == 1
    print clamp(-5, 1, 10);

    return 0;
}
