# ============================================================
# NanoPass Compiler Lab — .gitignore
# ============================================================

# CMake build trees (root and per-subproject)
/build/
/build-native/
/compiler/build/
/_audit_build/
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/CTestTestfile.cmake
compile_commands.json
CMakeUserPresets.json

# Ninja / Make artifacts
Makefile
build.ninja
.ninja_deps
.ninja_log

# MSVC / MSBuild artifacts
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.sln
*.suo
*.user
*.recipe
*.lastbuildstate
*.tlog/
ALL_BUILD.vcxproj
INSTALL.vcxproj
ZERO_CHECK.vcxproj

# Compiler output binaries
*.exe
*.dll
*.so
*.dylib
*.a
*.lib

# Object / debug files
*.obj
*.o
*.pdb
*.ilk
*.exp
*.map

# LLVM IR / assembly / bitcode — generated, never committed
*.ll
*.s
*.bc

# Graphviz generated output
*.dot
*.svg
*.png   # only generated graph images; source images committed elsewhere are fine

# Nano-specific compiler output
/compiler/program
/compiler/prog
/compiler/test_out

# Test / fuzzing artifacts
tests/regressions/
fuzz-artifacts/
crash-*
minimized-*
*.profraw
*.profdata
premium-audit.json

# Profile data
*.nprof
benchmark-results.json
benchmarks/results/
fuzz-run-summary.json
optimization-report.json
telemetry.json

# IDE state — never source
.idea/
.vscode/
*.code-workspace

# Node / web artifacts
web/node_modules/
web/.next/
web/dist/
web/out/
web/test-results/
web/playwright-report/
web/.env
web/.env.*
!web/.env.example
web/*.log
web/*.tsbuildinfo
.env
.env.*

# Python / misc tooling
__pycache__/
*.pyc
*.pyo
.DS_Store
Thumbs.db

